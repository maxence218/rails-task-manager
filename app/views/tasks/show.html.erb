<div class="container">
  <div>
    <h1><%= @task.title %></h1>
    <h2><%= @task.details %></h2>
  </div>
  <div class="d-flex justify-content-center">
    <%= link_to "edit", update_path, class: "m-2 p-2 text-decoration-none text-black shadow rounded "%>
    <%= link_to "delete", delete_path, data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}, class: "shadow rounded m-2 p-2 text-decoration-none text-black" %>
    <%= link_to "home page", tasks_path, class: "m-2 p-2 text-decoration-none text-black shadow rounded" %>
  </div>
</div>
