<div class="container">
  <div class="d-flex flex-column">
    <h1 class="pt-3">My tasks</h1>
    <div>
      <ul class="p-0">
        <% @tasks.each do |task| %>
          <div class="d-flex justify-content-center">
          <input type="checkbox"<%= "checked" if task.completed  %> disabled>
          <li class="list-unstyled mb-2 p-1"> <%= link_to task.title, task_path(task.id), class: "text-decoration-none text-black shadow rounded p-1"%></li>
        </div>
        <% end %>
      </ul>
    </div>
    <div class="">
      <%= link_to "Create a new task", tasks_new_path, class: "text-decoration-none text-black shadow rounded p-1"%>
    </div>
  </div>
</div>
