<div class="container">
  <%= form_with model: @task do |f| %>
  <h1>Write your new task</h1>
  <div class="card">
      <div class="card-body">
        <div class="input">
          <%= f.label :title, { class: "form-label m-2"} %>
          <%= f.text_field :title, { class: "form-control"} %>
        </div>
        <div class="input">
          <%= f.label :details, { class: "form-label m-2"} %>
          <%= f.text_field :details, { class: "form-control"} %>
        </div>
        <div class="d-flex justify-content-around">
          <%= f.submit class: "btn btn-primary" %>
          <%= link_to "Home page", tasks_path, class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  </div>
  <% end %>
</div>
